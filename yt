#!/usr/bin/env bash
#
# yt - A fast, keyboard-driven YouTube CLI player built on mpv + yt-dlp + fzf.
#
# Usage:
#   yt VIDEO_ID
#   yt URL
#   yt search terms
#   yt                            (start a blank search prompt)
#   yt -l search terms            (interactive fzf search)
#   yt -L search terms            (interactive fzf search + detailed metadata)
#
#   yt URL_OR_ID_OF_PLAYLIST      (browse/play a playlist, not saved)
#   yt --save-playlist URL        (save a playlist into your local library)
#   yt --playlists | --library    (browse saved playlists)
#   yt --study [NAME]             (resume a saved playlist where you left off)
#   yt --sync [NAME]              (refetch saved playlist(s), report new videos)
#   yt --shuffle NAME             (play a saved playlist shuffled)
#   yt --queue NameA,NameB,...    (play several saved playlists back to back)
#   yt --clean                    (manually deep-clean cache + all resume data)
#
# Options (can appear anywhere on the command line, not just before terms):
#   -480 / -720 / -1080     Max playback resolution (default 720)
#   -a / -audio              Audio only
#   -l                       Interactive search via fzf
#   -L                       Interactive search via fzf, show details before playback
#   -loop                    Loop the current video (or whole playlist) forever
#   --search | -s            Open a blank search prompt and then run fzf
#   --max-fps <n>            Limit playback to videos with <= n FPS
#   --block-60fps            Alias for --max-fps 30
#   -h | --help             Show this help message
#

# shellcheck disable=SC1091  # We intentionally source files; not checking them individually
set -Eeuo pipefail

# This script's directory (for sourcing library modules)
LIB_DIR="$(dirname "${BASH_SOURCE[0]}")/lib"
readonly LIB_DIR

# ---------------------------------------------------------------------------
# Source all library modules
# ---------------------------------------------------------------------------

# Load modules in dependency order
source "$LIB_DIR/logging.sh" || { echo "Failed to load logging.sh" >&2; exit 1; }
source "$LIB_DIR/utils.sh" || { die "Failed to load utils.sh"; }
source "$LIB_DIR/dependencies.sh" || { die "Failed to load dependencies.sh"; }

# Load user config before defaults so users can override settings safely.
USER_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/yt/config.sh"
if [[ -f "$USER_CONFIG_FILE" ]]; then
    log_info "Loading config: $USER_CONFIG_FILE"
    # shellcheck disable=SC1090
    source "$USER_CONFIG_FILE" || die "Failed to load user config"
fi

source "$LIB_DIR/config.sh" || { die "Failed to load config.sh"; }
source "$LIB_DIR/ui.sh" || { die "Failed to load ui.sh"; }
source "$LIB_DIR/search.sh" || { die "Failed to load search.sh"; }
source "$LIB_DIR/player.sh" || { die "Failed to load player.sh"; }
source "$LIB_DIR/playlists.sh" || { die "Failed to load playlists.sh"; }
source "$LIB_DIR/cache.sh" || { die "Failed to load cache.sh"; }

# ---------------------------------------------------------------------------
# Global State (populated by parse_flags)
# ---------------------------------------------------------------------------

AUDIO_ONLY=0
LIST_MODE=0
DETAILED_MODE=0
LOOP_MODE=0
ACTION=""
QUERY=""
QUALITY="$DEFAULT_QUALITY"

# ---------------------------------------------------------------------------
# Argument Parsing
# ---------------------------------------------------------------------------

# Parse command-line arguments
# Flags can appear anywhere in the command line
parse_flags() {
    local -a rest=()
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -480)
                QUALITY=480
                ;;
            -720)
                QUALITY=720
                ;;
            -1080)
                QUALITY=1080
                ;;
            -audio | -a)
                AUDIO_ONLY=1
                ;;
            -l)
                LIST_MODE=1
                ;;
            -L)
                LIST_MODE=1
                DETAILED_MODE=1
                ;;
            -loop | --loop)
                LOOP_MODE=1
                ;;
            --save-playlist)
                ACTION="save_playlist"
                ;;
            --playlists | --library)
                ACTION="library"
                ;;
            --study)
                ACTION="study"
                ;;
            --sync)
                ACTION="sync"
                ;;
            --shuffle)
                ACTION="shuffle_playlist"
                ;;
            --queue)
                ACTION="queue"
                ;;
            --clean | --clean-cache)
                ACTION="clean_cache"
                ;;
            --search | -s)
                LIST_MODE=1
                ;;
            --max-fps)
                shift || die "Missing value for --max-fps"
                if ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    die "Invalid value for --max-fps: $1"
                fi
                MAX_FPS="$1"
                ;;
            --block-60fps)
                MAX_FPS=30
                ;;
            -h | --help)
                ACTION="help"
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                rest+=("$1")
                ;;
        esac
        shift || true
    done
    
    QUERY="${rest[*]:-}"
}

# ---------------------------------------------------------------------------
# Action Handlers
# ---------------------------------------------------------------------------

# Prompt the user for a search query when none was provided
prompt_search_query() {
    read -r -p "Search query: " QUERY
    QUERY="$(trim "$QUERY")"
    if [[ -z "$QUERY" ]]; then
        return 1
    fi
    return 0
}

# Handle interactive search mode (-l or -L)
action_interactive_search() {
    if [[ -z "$QUERY" ]]; then
        prompt_search_query || return 0
    fi
    
    local id
    id=$(fzf_select_id "$QUERY") || return 0  # User cancelled
    
    if [[ $DETAILED_MODE -eq 1 ]]; then
        # Fetch and display metadata
        local detail
        detail=$(fetch_video_metadata "https://youtu.be/$id") || {
            log_warn "Could not fetch metadata, playing anyway..."
            play_video "https://youtu.be/$id" "$QUALITY" "$AUDIO_ONLY" "$LOOP_MODE"
            return 0
        }
        
        local title channel views duration upload_date
        title=$(jq -r '.title // "Unknown"' <<< "$detail")
        channel=$(jq -r '.channel // .uploader // "Unknown"' <<< "$detail")
        views=$(jq -r '.view_count // 0' <<< "$detail")
        duration=$(jq -r '.duration // 0' <<< "$detail")
        upload_date=$(jq -r '.upload_date // empty' <<< "$detail")
        
        show_video_metadata "$title" "$channel" "$views" "$upload_date" "$duration"
    fi
    
    play_video "https://youtu.be/$id" "$QUALITY" "$AUDIO_ONLY" "$LOOP_MODE"
}

# Handle direct video/URL/search input
action_play_video_or_search() {
    [[ -z "$QUERY" ]] && { show_usage; exit 1; }
    
    if is_playlist "$QUERY"; then
        browse_adhoc_playlist "$QUERY"
    elif is_http_url "$QUERY"; then
        play_video "$QUERY" "$QUALITY" "$AUDIO_ONLY" "$LOOP_MODE"
    elif is_video_id "$QUERY"; then
        play_video "https://youtu.be/$QUERY" "$QUALITY" "$AUDIO_ONLY" "$LOOP_MODE"
    else
        local vid
        vid=$(search_youtube "$QUERY") || return 1
        play_video "https://youtu.be/$vid" "$QUALITY" "$AUDIO_ONLY" "$LOOP_MODE"
    fi
}

# Handle --save-playlist
action_save_playlist() {
    [[ -z "$QUERY" ]] && die "Usage: yt --save-playlist <playlist URL or ID>"
    save_playlist "$QUERY"
}

# Handle --playlists / --library
action_library_browse() {
    local file
    file=$(library_browse) || return 0  # User cancelled
    browse_saved_playlist "$file"
}

# Handle --study
action_study() {
    if [[ -z "$QUERY" ]]; then
        # No name provided, show library browser in study mode
        local file
        file=$(library_browse) || return 0
        resume_saved_playlist "$file"
    else
        # Name provided, resume directly
        local file
        file=$(find_playlist_by_name "$QUERY") || {
            die "No saved playlist matching: $QUERY"
        }
        resume_saved_playlist "$file"
    fi
}

# Handle --sync
action_sync() {
    sync_all_playlists "$QUERY"
}

# Handle --shuffle
action_shuffle() {
    [[ -z "$QUERY" ]] && die "Usage: yt --shuffle <playlist name>"
    
    local file
    file=$(find_playlist_by_name "$QUERY") || {
        die "No saved playlist matching: $QUERY"
    }
    
    shuffle_saved_playlist "$file"
}

# Handle --queue
action_queue() {
    [[ -z "$QUERY" ]] && die "Usage: yt --queue NameA,NameB,..."
    
    local -a names urls
    IFS=',' read -ra names <<< "$QUERY" || die "Failed to parse playlist names"
    
    local name trimmed file url
    for name in "${names[@]}"; do
        trimmed=$(trim "$name") || true
        file=$(find_playlist_by_name "$trimmed") || {
            log_warn "Skipping unknown playlist: $trimmed"
            continue
        }
        url=$(jq -r '.source_url' "$file") || continue
        urls+=("$url")
    done
    
    if [[ ${#urls[@]} -eq 0 ]]; then
        die "No valid playlists found to queue"
    fi
    
    log_info "Queuing: ${names[*]}"
    play_queue "$QUALITY" "$AUDIO_ONLY" "$LOOP_MODE" "${urls[@]}"
}

# Handle --clean
action_clean_all() {
    clean_all_cache
}

# ---------------------------------------------------------------------------
# Cleanup on Exit
# ---------------------------------------------------------------------------

# Clean up when script exits (normally, error, or Ctrl-C)
on_exit() {
    local exit_code=$?
    cleanup_session
    exit "$exit_code"
}

# ---------------------------------------------------------------------------
# Main Entry Point
# ---------------------------------------------------------------------------

main() {
    # Parse command-line arguments first so help works without installed dependencies
    parse_flags "$@"

    if [[ "$ACTION" == "help" ]]; then
        show_usage
        exit 0
    fi

    # Verify dependencies before doing anything else
    verify_dependencies || die "Dependency check failed. Install required tools and try again."
    
    # Initialize directories
    init_xdg_dirs || die "Failed to initialize data directories"
    
    # Export config for child processes
    export_mpv_config
    
    # If the user launches the script without a query, open a blank search prompt
    # so desktop launchers and casual invocations feel natural.
    if [[ -z "$ACTION" && -z "$QUERY" && $LIST_MODE -eq 0 ]]; then
        LIST_MODE=1
    fi

    # Dispatch to appropriate action handler
    case "$ACTION" in
        save_playlist)    action_save_playlist ;;
        library)          action_library_browse ;;
        study)            action_study ;;
        sync)             action_sync ;;
        shuffle_playlist) action_shuffle ;;
        queue)            action_queue ;;
        clean_cache)      action_clean_all ;;
        *)
            # No action flag: check for interactive search or direct play
            if [[ $LIST_MODE -eq 1 ]]; then
                action_interactive_search
            else
                action_play_video_or_search
            fi
            ;;
    esac
}

# Set up cleanup trap
trap on_exit EXIT

# Run main program
main "$@"
